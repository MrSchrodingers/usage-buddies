[Desktop Entry]
Type=Application
Name=AI Central · Ativar HTTPS privado
Comment=Autorizar o Tailscale Serve para PWA e notificações no celular
Exec=/bin/sh -lc "exec /usr/bin/konsole --separate -p tabtitle=AI-Central-HTTPS -e $HOME/.local/bin/ai-central-enable-https.sh"
Icon=security-high
Terminal=false
Categories=Development;
StartupNotify=true

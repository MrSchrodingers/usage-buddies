[Unit]
Description=Private AI Central web and terminal interface
After=claude-hub.service ai-hub-restore.service
Requires=claude-hub.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/ai-central-web.py --host tailscale --port 8765
Restart=always
RestartSec=4
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

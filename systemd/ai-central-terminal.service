[Unit]
Description=Single synchronized Konsole for AI Central
After=graphical-session.target ai-hub-restore.service
Requires=ai-hub-restore.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/konsole --separate -p tabtitle=AI-Central -e /home/ti/.local/bin/claude-hub attach
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
